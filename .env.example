# Copy to .env and supply an OpenAI-compatible chat-completions model.
LLM_API_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_api_key_here
# Distinct project names and ports allow isolated release verification.
COMPOSE_PROJECT_NAME=codeaudit-final
CODEAUDIT_MCP_PORT=19013
CODEAUDIT_DAEMON_PORT=17420
# start.sh generates local-only authentication and workspace configuration.
