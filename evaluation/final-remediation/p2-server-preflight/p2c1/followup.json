  "cli_help": {
    "octobus": {
      "exit_code": 0,
      "stdout": "Octobus daemon and administration CLI\n\nUsage:\n  octobus <commands>\n\nAvailable Commands:\n  admin-token Manage admin access tokens\n  capset      Manage capability sets\n  catalog     Show a capset protocol catalog\n  completion  Generate the autocompletion script for the specified shell\n  help        Help about any command\n  instance    Manage service instances\n  logs        Show access logs\n  serve       Run the Octobus daemon\n  service     Manage service packages\n  status      Show daemon status\n  version     Print version information\n\nFlags:\n      --addr string   daemon admin address (default \"0.0.0.0:9000\")\n  -h, --help          help for octobus\n\nUse \"octobus COMMAND --help\" for more information about a command.\n",
      "stderr": ""
    },
    "scheduler": {
      "exit_code": 0,
      "stdout": "Run, inspect, and operate project schedulers, runs, logs, and triggers\n\nUsage:\n  agent-compose scheduler [flags]\n  agent-compose scheduler [command]\n\nAvailable Commands:\n  inspect     Inspect a scheduler, trigger, or scheduler run\n  logs        Print scheduler run logs\n  ls          List project scheduler triggers\n  run         Run a scheduler main function\n  runs        List project scheduler runs\n  stop        Stop an active scheduler run\n  trigger     Manually run a scheduler trigger\n\nFlags:\n  -h, --help   help for scheduler\n\nGlobal Flags:\n  -f, --file string           Path to agent-compose.yml\n      --host string           Daemon HTTP endpoint\n      --json                  Print machine-readable JSON\n      --project-name string   Override compose project name\n\nUse \"agent-compose scheduler [command] --help\" for more information about a command.\n",
      "stderr": ""
    }
